{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video Studio Semantic Source v1",
  "type": "object",
  "required": [
    "project_id",
    "task",
    "brief",
    "output",
    "video",
    "segments",
    "transcript_origin"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,80}$"
    },
    "task": {
      "const": "EDITORIAL_PLAN"
    },
    "brief": {
      "type": "object",
      "required": [
        "viewer",
        "goal",
        "platform",
        "language"
      ],
      "properties": {
        "viewer": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "const": 720
        },
        "height": {
          "const": 1280
        },
        "fps": {
          "const": 30
        }
      }
    },
    "video": {
      "type": "object",
      "required": [
        "duration_ms"
      ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "source_rights": {
          "type": "string"
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "clip_id",
          "start_ms",
          "end_ms",
          "text"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "clip_id": {
            "type": "string"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "license_status"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "license_status": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "at_ms"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "at_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "story": {
      "type": "object"
    },
    "transcript_origin": {
      "enum": [
        "HUMAN_VERIFIED",
        "ASR_UNVERIFIED",
        "TEST_FIXTURE"
      ]
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "clip_id",
          "path",
          "src",
          "source_sha256",
          "timeline_start_ms",
          "source_in_ms",
          "duration_ms",
          "base_scale",
          "captions_burned"
        ],
        "properties": {
          "clip_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "timeline_start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "source_in_ms": {
            "type": "integer",
            "minimum": 0
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1
          },
          "base_scale": {
            "type": "number",
            "minimum": 1,
            "maximum": 1.5
          },
          "captions_burned": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
